# 환경변수 예시 파일
#
# 사용법: 이 파일을 복사해서 `.env` 를 만들고 값을 채운다.
#   - `.env` 는 절대 커밋하지 않는다 (.gitignore 에 등록됨).
#   - 배포 환경(Netlify)에서는 대시보드의
#     Site settings > Environment variables 에 같은 키로 등록한다.
#
# 중요: 개인 계정 고유 값(개인 이메일, 개인 API 토큰, 개인 사이트 ID 등)을
#       코드나 설정 파일에 직접 쓰지 말고 반드시 여기(.env)로 뺀다.
#       이 프로젝트는 개인 계정에서 시작하지만 나중에 연구실 공용 계정으로 넘어간다.

# =====================================================================
# Notion API — 콘텐츠 단일 원본
# =====================================================================
# 아래 값들은 빌드 타임에만 사용된다. PUBLIC_ 접두사가 없으므로
# 브라우저 번들에는 절대 포함되지 않는다.
#
# 토큰 발급: notion.so → Settings → Connections → 내부 통합(integration) 생성
#            → Internal Integration Secret 복사.
#            반드시 연구실 공용 계정으로 발급할 것 (개인 토큰 금지).
# 주의: 통합을 만든 뒤, 각 데이터베이스에서 `••• → 연결(Connections)` 로
#       그 통합을 추가해야 API가 읽을 수 있다.
NOTION_TOKEN=

# 각 데이터베이스의 Data Source ID (Database ID 가 아님).
# 조회는 data source 단위로 이뤄진다: POST /v1/data_sources/{id}/query
# 접두사 없는 UUID 형태로 넣는다. 예) 00b2dab6-e905-836a-bc3a-01427adcda7e
NOTION_MEMBERS_DATA_SOURCE_ID=
NOTION_RESEARCH_DATA_SOURCE_ID=
NOTION_PROJECTS_DATA_SOURCE_ID=
NOTION_PUBLICATIONS_DATA_SOURCE_ID=
NOTION_PATENTS_DATA_SOURCE_ID=
NOTION_AWARDS_DATA_SOURCE_ID=
NOTION_NEWS_DATA_SOURCE_ID=
NOTION_RESOURCES_DATA_SOURCE_ID=
NOTION_PI_PROFILE_DATA_SOURCE_ID=

# =====================================================================
# Google Sheets (현재 미사용)
# =====================================================================
# 콘텐츠 원본은 Notion 으로 확정되었다. 아래 키는 과거 검토 흔적이며
# 지금은 코드에서 사용하지 않는다. 필요 없어지면 삭제해도 된다.
PUBLIC_SHEET_MEMBERS_CSV_URL=
PUBLIC_SHEET_PUBLICATIONS_CSV_URL=
PUBLIC_SHEET_NEWS_CSV_URL=
