# 환경변수 예시 파일
#
# 사용법: 이 파일을 복사해서 `.env` 를 만들고 값을 채운다.
#   - `.env` 는 절대 커밋하지 않는다 (.gitignore 에 등록됨).
#   - 배포 환경(Netlify)에서는 대시보드의
#     Site settings > Environment variables 에 같은 키로 등록한다.
#
# 중요: 개인 계정 고유 값(개인 이메일, 개인 API 토큰, 개인 사이트 ID 등)을
#       코드나 설정 파일에 직접 쓰지 말고 반드시 여기(.env)로 뺀다.
#       이 프로젝트는 개인 계정에서 시작하지만 나중에 연구실 공용 계정으로 넘어간다.
#
# 참고: 아래 키들은 아직 코드에서 사용하지 않는다.
#       나중에 Google Sheets / Notion 연동을 붙일 때 필요한 값의 목록이다.
#       실제 연동 시 키 이름은 조정될 수 있다.

# --- Google Sheets (콘텐츠 데이터) ---
# 각 시트를 '웹에 게시(Publish to the web)' 하여 만든 CSV URL.
# PUBLIC_ 접두사가 붙은 값은 빌드 결과물에 노출될 수 있으니 비밀이 아닌 URL만 넣는다.
PUBLIC_SHEET_MEMBERS_CSV_URL=
PUBLIC_SHEET_PUBLICATIONS_CSV_URL=
PUBLIC_SHEET_NEWS_CSV_URL=

# --- Notion API (콘텐츠 데이터) ---
# Notion 통합(integration) 토큰. 연구실 공용 계정으로 발급할 것 (개인 토큰 금지).
NOTION_API_TOKEN=
# 가져올 Notion 데이터베이스 ID.
NOTION_DATABASE_ID=
