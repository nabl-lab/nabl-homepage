---
// 논문 분류 필터 — JS 없이 별도 경로로 이동하는 링크 바.
// 분류 값은 Notion `Type` 선택지 그대로 쓰고(Patent 제외), URL 은 소문자로 만든다.
// 활성 항목만 크림슨(클릭 가능한 요소이므로 원칙에 부합).
import { useTranslations, withLocale, optionLabel, type Locale } from "../i18n/utils";
import { PUBLICATION_TYPES, typeToSlug } from "../lib/notion/publication-types";

interface Props {
  lang: Locale;
  /** 현재 분류(Notion Type 값). null 이면 "전체" */
  active: string | null;
}

const { lang, active } = Astro.props;
const t = useTranslations(lang);
---

<nav
  aria-label={t("a11y.filterPublications")}
  class="flex flex-wrap gap-2 border-b border-line pb-3 text-sm"
>
  <a
    href={withLocale(lang, "/achievements/publications")}
    aria-current={active === null ? "page" : undefined}
    class:list={[
      "rounded px-3 py-1.5",
      active === null
        ? "bg-brand-tint font-semibold text-brand"
        : "text-ink hover:bg-surface-muted hover:text-brand",
    ]}
  >
    {t("pub.filterAll")}
  </a>
  {
    PUBLICATION_TYPES.map((type) => (
      <a
        href={withLocale(
          lang,
          `/achievements/publications/${typeToSlug(type)}`,
        )}
        aria-current={type === active ? "page" : undefined}
        class:list={[
          "rounded px-3 py-1.5",
          type === active
            ? "bg-brand-tint font-semibold text-brand"
            : "text-ink hover:bg-surface-muted hover:text-brand",
        ]}
      >
        {optionLabel("publicationType", type, lang)}
      </a>
    ))
  }
</nav>
