---
// 논문 분류 필터 — JS 없이 별도 경로로 이동하는 링크 바.
// 분류 값은 Notion `Type` 선택지 그대로 쓰고(Patent 제외), URL 은 소문자로 만든다.
//
// 0건인 분류는 탭을 숨긴다 (죽은 링크 방지). 분류가 1종류 이하면 "전체" 와 같은
// 목록이 되므로 필터 바 자체를 렌더하지 않는다. Notion 에 다른 분류가 들어오면
// 탭이 자동으로 나타난다.
import { useTranslations, withLocale, optionLabel, type Locale } from "../i18n/utils";
import { PUBLICATION_TYPES, typeToSlug } from "../lib/notion/publication-types";

interface Props {
  lang: Locale;
  /** 현재 분류(Notion Type 값). null 이면 "전체" */
  active: string | null;
  /** Type → 건수 */
  counts: Record<string, number>;
  total: number;
}

const { lang, active, counts, total } = Astro.props;
const t = useTranslations(lang);

const shown = PUBLICATION_TYPES.filter((type) => (counts[type] ?? 0) > 0);
const visible = shown.length > 1;

const tabClass = (isActive: boolean) =>
  isActive
    ? "bg-brand-tint font-semibold text-brand"
    : "text-ink hover:bg-surface-muted hover:text-brand";
---

{
  visible && (
    <nav
      aria-label={t("a11y.filterPublications")}
      class="flex flex-wrap gap-2 border-b border-line pb-3 text-sm"
    >
      <a
        href={withLocale(lang, "/research/publications")}
        aria-current={active === null ? "page" : undefined}
        class:list={["rounded px-3 py-1.5", tabClass(active === null)]}
      >
        {t("pub.filterAll")}
        <span class="text-ink-muted tabular-nums"> {total}</span>
      </a>
      {shown.map((type) => (
        <a
          href={withLocale(lang, `/research/publications/${typeToSlug(type)}`)}
          aria-current={type === active ? "page" : undefined}
          class:list={["rounded px-3 py-1.5", tabClass(type === active)]}
        >
          {optionLabel("publicationType", type, lang)}
          <span class="text-ink-muted tabular-nums"> {counts[type]}</span>
        </a>
      ))}
    </nav>
  )
}
