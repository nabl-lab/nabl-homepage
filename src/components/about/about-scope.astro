---
// About — Research Scope. 왼쪽: 큰 문장(about.scope.lead) / 오른쪽: Research DB 의 Scope 행 카드.
// 둘 다 비면 섹션을 렌더하지 않는다 (about.astro 가 판단).
import type { ScopeBlock } from "../../lib/about-areas";
import { useTranslations, type Locale } from "../../i18n/utils";

interface Props {
  lang: Locale;
  lead: string | null;
  blocks: ScopeBlock[];
}

const { lang, lead, blocks } = Astro.props;
const t = useTranslations(lang);
---

<section id="scope" class="border-y border-line bg-surface-muted">
  <div
    class="mx-auto grid max-w-6xl items-end gap-8 px-4 py-14 sm:py-24 min-[761px]:grid-cols-2 min-[761px]:gap-16"
  >
    <div>
      <h2 class="text-xs font-bold uppercase tracking-[0.16em] text-logo-red">
        {t("nav.research.scope")}
      </h2>
      {
        lead && (
          <p class="mt-3 text-[clamp(1.7rem,3.6vw,2.8rem)] leading-[1.18] font-extrabold tracking-tight text-ink">
            {lead}
          </p>
        )
      }
    </div>

    <div class="flex min-w-0 flex-col gap-6">
      {
        blocks.map((b) => (
          <div class="grid gap-2.5">
            {b.title && <h3 class="text-xl font-bold text-logo-navy">{b.title}</h3>}
            <p class="leading-relaxed text-ink-muted">{b.description}</p>
          </div>
        ))
      }
      {/* 네 분야 색 띠 — 장식 */}
      <div class="flex h-1.5 overflow-hidden rounded-sm" aria-hidden="true">
        <i class="flex-1 bg-area-n"></i>
        <i class="flex-1 bg-area-a"></i>
        <i class="flex-1 bg-area-b"></i>
        <i class="flex-1 bg-area-l"></i>
      </div>
    </div>
  </div>
</section>
