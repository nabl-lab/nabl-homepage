---
// 사이트 헤더: 로고 · 주 메뉴(SiteNav) · 언어 전환.
// 메뉴 항목·활성 표시 로직은 SiteNav 담당. 모바일에서는 <details> 로 메뉴를 펼친다(무-JS).
import LanguageSwitcher from "./language-switcher.astro";
import SiteNav from "./site-nav.astro";
import SiteNavMobile from "./site-nav-mobile.astro";
import { useTranslations, withLocale, type Locale } from "../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a
      href={withLocale(lang)}
      class="text-lg font-bold tracking-tight text-brand"
    >
      {t("site.shortName")}
    </a>

    <div class="flex items-center gap-3">
      <nav aria-label={t("a11y.primaryNav")} class="hidden md:block">
        <SiteNav lang={lang} />
      </nav>

      <div class="border-l border-line pl-3">
        <LanguageSwitcher lang={lang} />
      </div>

      <details class="relative md:hidden">
        <summary
          class="flex cursor-pointer items-center rounded border border-line px-2 py-1 text-sm list-none [&::-webkit-details-marker]:hidden"
        >
          {t("a11y.openMenu")}
        </summary>
        <nav
          aria-label={t("a11y.primaryNav")}
          class="absolute right-0 z-50 mt-2 w-60 rounded border border-line bg-surface p-2 shadow-lg"
        >
          <SiteNavMobile lang={lang} />
        </nav>
      </details>
    </div>
  </div>
</header>
