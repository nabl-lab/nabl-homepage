---
// 인물 신원 블록(사이드바) — 사진 / 이름(현재 언어 + 반대 언어) / 직위 / 소속 / 연락처 / 외부 링크.
// PI 페이지와 구성원 상세가 **같이** 쓴다. 한쪽만 고치지 마라.
// 두 칸 배치·sticky 는 profile-layout.astro 가 맡고, 여기는 세로로 쌓기만 한다.
//
// 비어 있는 줄은 통째로 숨긴다. 교수님만 Position·Office·전화가 채워져 있고
// 다른 구성원은 대부분 비어 있어서, "숨김"이 기본 동작이다.
import PersonPhoto from "../person-photo.astro";
import { localizedText, type Member } from "../../lib/content";
import { positionLine, profileLinks } from "../../lib/person";
import { useTranslations, optionLabel, type Locale } from "../../i18n/utils";

interface Props {
  member: Member;
  lang: Locale;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);

const name = localizedText(member, "name", lang) ?? member.name_ko;
// 반대 언어 이름. 같은 값이면(한쪽만 입력) 중복이라 보여 주지 않는다.
const otherName = lang === "ko" ? member.name : member.name_ko;
const subName = otherName && otherName !== name ? otherName : null;

const position = positionLine(
  localizedText(member, "positionTitle", lang),
  optionLabel("memberPosition", member.position, lang),
);
const office = localizedText(member, "office", lang);
const links = profileLinks(member);

// 연락처는 라벨을 위, 값을 아래에 둔다 (좁은 사이드바에서 긴 이메일이 줄바꿈되지 않게).
const contacts = [
  // publicEmail 은 지도교수만 값이 있다 (연구원 이메일은 데이터 단계에서 빠짐).
  member.publicEmail && {
    label: t("common.email"),
    value: member.publicEmail,
    href: `mailto:${member.publicEmail}`,
  },
  office && { label: t("pi.officeLabel"), value: office },
  member.officePhone && { label: t("person.phoneLabel"), value: member.officePhone },
].filter((c): c is { label: string; value: string; href?: string } => Boolean(c));
---

<div>
  <PersonPhoto name={name} photo={member.photo} />

  <h2 class="mt-6 text-[28px] font-bold leading-tight tracking-tight text-ink">{name}</h2>
  {subName && <p class="mt-1 text-[15px] text-ink-muted">{subName}</p>}

  {position && <p class="mt-4 text-[15px] font-semibold leading-normal text-ink">{position}</p>}
  <p class="mt-1 text-sm leading-normal text-ink-muted">{t("site.affiliation")}</p>

  {
    contacts.length > 0 && (
      <dl class="mt-5 flex flex-col gap-3 text-sm leading-normal">
        {contacts.map((c) => (
          <div>
            <dt class="mb-0.5 text-xs text-ink-subtle">{c.label}</dt>
            <dd class="break-words text-ink">
              {c.href ? (
                <a href={c.href} class="text-brand hover:underline">
                  {c.value}
                </a>
              ) : (
                c.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    )
  }

  {
    /* 외부 프로필 — 셋 다 비면 profileLinks 가 빈 배열이라 이 영역이 사라진다. */
    links.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class="inline-block rounded border border-line px-3 py-1.5 text-sm text-brand hover:bg-brand-tint"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>
