---
// 인물 신원 블록 — 사진 / 이름(현재 언어 + 반대 언어) / 직위 / 소속 / 연락처 / 외부 링크.
// PI 페이지와 구성원 상세가 **같이** 쓴다. 한쪽만 고치지 마라.
//
// 비어 있는 줄은 통째로 숨긴다. 교수님만 Position·Office·전화가 채워져 있고
// 다른 구성원은 대부분 비어 있어서, "숨김"이 기본 동작이다.
import PersonPhoto from "../person-photo.astro";
import { localizedText, type Member } from "../../lib/content";
import { positionLine, profileLinks } from "../../lib/person";
import { useTranslations, optionLabel, type Locale } from "../../i18n/utils";

interface Props {
  member: Member;
  lang: Locale;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);

const name = localizedText(member, "name", lang) ?? member.name_ko;
// 반대 언어 이름. 같은 값이면(한쪽만 입력) 중복이라 보여 주지 않는다.
const otherName = lang === "ko" ? member.name : member.name_ko;
const subName = otherName && otherName !== name ? otherName : null;

const position = positionLine(
  localizedText(member, "positionTitle", lang),
  optionLabel("memberPosition", member.position, lang),
);
const office = localizedText(member, "office", lang);
const links = profileLinks(member);
---

<div class="flex flex-col gap-8 sm:flex-row sm:items-start">
  <div class="w-full max-w-48 shrink-0">
    <PersonPhoto name={name} photo={member.photo} lang={lang} />
  </div>

  <div class="min-w-0 flex-1">
    <h2 class="text-2xl font-bold text-ink">{name}</h2>
    {subName && <p class="mt-0.5 text-sm text-ink-muted">{subName}</p>}

    {position && <p class="mt-3 text-ink">{position}</p>}
    <p class="mt-0.5 text-sm text-ink-muted">{t("site.affiliation")}</p>

    <dl class="mt-5 flex flex-col gap-1.5 text-sm">
      {
        member.email && (
          <div class="flex gap-3">
            <dt class="w-16 shrink-0 text-ink-muted">{t("common.email")}</dt>
            <dd class="min-w-0">
              <a href={`mailto:${member.email}`} class="text-brand hover:underline">
                {member.email}
              </a>
            </dd>
          </div>
        )
      }
      {
        office && (
          <div class="flex gap-3">
            <dt class="w-16 shrink-0 text-ink-muted">{t("pi.officeLabel")}</dt>
            <dd class="min-w-0 text-ink">{office}</dd>
          </div>
        )
      }
      {
        member.officePhone && (
          <div class="flex gap-3">
            <dt class="w-16 shrink-0 text-ink-muted">{t("person.phoneLabel")}</dt>
            <dd class="min-w-0 text-ink">{member.officePhone}</dd>
          </div>
        )
      }
    </dl>

    {
      /* 외부 프로필 — 셋 다 비면 profileLinks 가 빈 배열이라 이 영역이 사라진다. */
      links.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                class="inline-block rounded border border-line px-3 py-1.5 text-sm text-brand hover:bg-brand-tint"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
