---
// 인물 화면의 섹션 한 덩어리 — 상단 구분선 + 작은 대문자 제목 + 본문(slot).
//
// 기존 section.astro 는 큰 h2 제목을 쓰는 페이지용이라 위계가 다르다.
// 여기는 한 페이지 안에서 블록을 가르는 용도라 제목을 작게 둔다 (시안의 위계).
// 제목은 h2: 페이지 h1(PageHeader) 바로 아래 최상위 블록 제목이다.
interface Props {
  title: string;
  /** 페이지 내 앵커용 id (선택) */
  id?: string;
}

const { title, id } = Astro.props;
---

<section id={id} class="border-t border-line pt-8">
  <h2
    class="mb-5 text-xs font-semibold uppercase tracking-widest text-ink-muted"
  >
    {title}
  </h2>
  <slot />
</section>
