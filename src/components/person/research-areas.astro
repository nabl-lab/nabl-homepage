---
// 연구 분야 카드 — 구성원의 「연구 분야 (Research)」 관계에서 온다.
// PI 페이지와 구성원 상세가 같이 쓴다. 0건이면 호출부가 이 블록을 렌더하지 않는다.
//
// 링크는 그 Research 행이 **공개(Publish)됐고 Slug 가 있을 때만** 건다.
// 지금은 5행 모두 미공개라 링크 없는 카드로 나오는 것이 정상이다
// (판정은 lib/research.ts 의 hasDetailPage 와 같은 규칙).
import { localizedText, type MemberResearchArea } from "../../lib/content";
import { sortedAreas } from "../../lib/person";
import { withLocale, type Locale } from "../../i18n/utils";

interface Props {
  areas: MemberResearchArea[];
  lang: Locale;
}

const { areas, lang } = Astro.props;

const cards = sortedAreas(areas)
  .map((a) => {
    const title = localizedText(a, "title", lang);
    return {
      code: a.code,
      title,
      // 영문 제목은 한국어 화면에서만 보조로 덧붙인다 (영문 화면에서는 중복이다).
      subtitle: title && title !== a.title ? a.title : null,
      keywords: a.keywords,
      href:
        a.publish && a.slug.trim()
          ? withLocale(lang, `/research/${a.slug}`)
          : null,
    };
  })
  .filter((c) => c.title);
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    cards.map((c) => (
      <li class="flex flex-col rounded-lg border border-line bg-surface p-5">
        {c.code && (
          <span class="mb-3 inline-flex h-7 w-7 items-center justify-center rounded border border-line text-xs font-semibold text-ink-muted">
            {c.code}
          </span>
        )}
        <h3 class="text-base font-semibold leading-snug text-ink">
          {c.href ? (
            <a href={c.href} class="text-brand hover:underline">
              {c.title}
            </a>
          ) : (
            c.title
          )}
        </h3>
        {c.subtitle && <p class="mt-1 text-sm text-ink-subtle">{c.subtitle}</p>}
        {c.keywords.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5">
            {c.keywords.map((k) => (
              <li class="rounded-full bg-surface-muted px-2 py-0.5 text-xs text-ink-muted">
                {k}
              </li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ul>
