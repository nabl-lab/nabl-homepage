---
// 구성원 카드. 사진은 person-photo.astro 가 담당 (없으면 이니셜 플레이스홀더).
import PersonPhoto from "./person-photo.astro";
import { localizedText, type Member } from "../lib/content";
import { useTranslations, withLocale, type Locale } from "../i18n/utils";

interface Props {
  member: Member;
  lang: Locale;
}

const { member, lang } = Astro.props;
const t = useTranslations(lang);

const name = localizedText(member, "name", lang) ?? member.id;
const topic = localizedText(member, "researchTopic", lang);
// 연구 설명(2~3문장). 카드에서는 길이가 들쭉날쭉하면 격자가 어긋나므로 3줄에서 자른다.
// 전체 문장은 상세 페이지에서 본다.
// 글자 크기는 연구 주제와 같게 두고(text-sm) **색만** 연하게 해서 위계를 준다.
const description = localizedText(member, "researchDescription", lang);
---

<article class="flex flex-col">
  <PersonPhoto name={name} photo={member.photo} lang={lang} />
  <h3 class="mt-3 font-semibold text-ink">
    {
      member.slug ? (
        <a
          href={withLocale(lang, `/members/${member.slug}`)}
          class="hover:text-brand hover:underline"
        >
          {name}
        </a>
      ) : (
        name
      )
    }
  </h3>
  {topic && <p class="mt-1 text-sm text-ink-muted">{topic}</p>}
  {
    description && (
      <p class="mt-1 line-clamp-3 text-sm leading-relaxed text-ink-subtle">
        {description}
      </p>
    )
  }
  {
    member.email && (
      <a
        href={`mailto:${member.email}`}
        class="mt-2 text-sm text-brand hover:underline"
      >
        {t("common.email")}
      </a>
    )
  }
</article>
