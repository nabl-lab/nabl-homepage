---
// 404 페이지. 호스트(Netlify)는 경로와 무관하게 /404.html 하나만 서빙하므로
// [lang] 아래가 아니라 최상위에 두고, 두 언어를 함께 보여준다.
import "../styles/global.css";
import { ui } from "../i18n/ui";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>404 · {ui.en["site.shortName"]}</title>
  </head>
  <body
    class="flex min-h-screen flex-col items-center justify-center gap-6 bg-surface px-4 text-center text-ink"
  >
    <p class="text-6xl font-bold text-brand">404</p>
    <div class="space-y-1 text-lg font-medium">
      <p>Page not found</p>
      <p lang="ko">페이지를 찾을 수 없습니다</p>
    </div>
    <div class="flex flex-wrap justify-center gap-4 text-sm font-medium">
      <a href="/en/" class="text-brand hover:underline">Go to homepage</a>
      <a href="/ko/" lang="ko" class="text-brand hover:underline">홈으로 가기</a>
    </div>
  </body>
</html>
