---
// 연구실 소개 (/about · /ko/about).
//
// 순서: 히어로(로고 + 소개 1문단) → Research Scope → Research Areas(N·A·B·L) → Mission.
// 문구는 전부 Notion 에서 온다.
//   - 「페이지 문구」 DB: about.intro(첫 문단만 히어로에), about.scope.lead, about.areas.lead,
//     about.mission
//   - Research DB: Category=Scope → Scope 카드, Category=Theme → 분야 패널 (lib/about-areas.ts)
// 비어 있는 섹션은 통째로 렌더하지 않는다. 섹션마다 화면 조각은 components/about/ 에 있다.
import BaseLayout from "../../layouts/base-layout.astro";
import AboutHero from "../../components/about/about-hero.astro";
import AboutScope from "../../components/about/about-scope.astro";
import AboutAreas from "../../components/about/about-areas.astro";
import AboutMission from "../../components/about/about-mission.astro";
import { researchAreas, paragraphs, oneParagraph, siteContent } from "../../lib/content";
import { areaPanels, scopeBlocks } from "../../lib/about-areas";
import {
  pageLocale,
  localePaths,
  useTranslations,
} from "../../i18n/utils";

export const getStaticPaths = localePaths;

const lang = pageLocale(Astro.params.lang);
const t = useTranslations(lang);

// about.intro 는 3문단이지만 히어로에는 첫 문단만 쓴다 (2·3문단은 분야 패널과 내용이 겹친다).
const intro = paragraphs(siteContent, "about.intro", lang)[0] ?? null;
const scopeLead = oneParagraph(siteContent, "about.scope.lead", lang);
const areasLead = oneParagraph(siteContent, "about.areas.lead", lang);
const mission = paragraphs(siteContent, "about.mission", lang);

const scope = scopeBlocks(researchAreas, lang);
const panels = areaPanels(researchAreas, lang);
---

<BaseLayout lang={lang} title={t("about.title")} description={intro ?? undefined}>
  <AboutHero lang={lang} intro={intro} />
  {(scopeLead || scope.length > 0) && <AboutScope lang={lang} lead={scopeLead} blocks={scope} />}
  {panels.length > 0 && <AboutAreas lang={lang} lead={areasLead} panels={panels} />}
  {mission.length > 0 && <AboutMission lang={lang} paragraphs={mission} />}
</BaseLayout>
