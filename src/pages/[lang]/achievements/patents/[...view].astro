---
// 특허 (/[lang]/achievements/patents[/filed]).
//
// 상단 버튼 두 개로 등록/출원을 나눠 본다. 필터는 JS 없이 별도 정적 경로로 만든다
// (이 사이트의 기존 방식). 기본 경로는 등록 목록이다.
//
// 등록/출원 구분은 Notion `Status` 선택지 철자가 아니라 등록번호·등록일 유무로
// 판단한다. 판단 규칙은 src/lib/patents.ts 한 곳에 있다.
//
// 항목별 Status 배지(Registered / Filed)는 **일부러 뺐다.** 상단 탭이 이미 등록/출원을
// 가르고 있어서, 등록 목록의 모든 줄에 "등록" 이 또 붙는 중복이었다.
// 되살려야 할 때: Transferred(기술이전)·Published(공개)처럼 **탭만으로는 알 수 없는**
// 상태가 데이터에 들어오면, 그때는 그 값만 가려서 배지로 보여 주는 쪽이 좋다
// (전부 다시 붙이면 같은 중복이 된다). 라벨은 i18n/options.ts 의 patentStatus 가
// 그대로 들고 있고, 데이터의 p.status 도 남아 있으므로 표시 코드만 더하면 된다.
import BaseLayout from "../../../../layouts/base-layout.astro";
import PageHeader from "../../../../components/page-header.astro";
import Section from "../../../../components/section.astro";
import YearGroup from "../../../../components/year-group.astro";
import PatentFilter from "../../../../components/patent-filter.astro";
import EmptyState from "../../../../components/empty-state.astro";
import { patents, groupByYear, localizedText } from "../../../../lib/content";
import {
  DEFAULT_PATENT_VIEW,
  PATENT_VIEWS,
  splitPatents,
  type PatentView,
} from "../../../../lib/patents";
import {
  LOCALES,
  useTranslations,
  optionLabel,
  type Locale,
} from "../../../../i18n/utils";
import { collectionLabel } from "../../../../config/collections";

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    PATENT_VIEWS.map((view) => ({
      // 기본 구분(등록)은 접미사 없는 경로로 만든다.
      params: { lang, view: view === DEFAULT_PATENT_VIEW ? undefined : view },
      props: { view },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { view } = Astro.props as { view: PatentView };
const t = useTranslations(lang);

const split = splitPatents(patents);
const counts = { registered: split.registered.length, filed: split.filed.length };
const groups = groupByYear(split[view]);
---

<BaseLayout lang={lang} title={collectionLabel("patents", lang)}>
  <PageHeader title={collectionLabel("patents", lang)} lede={t("patent.lede")} />

  <div class="mx-auto max-w-6xl px-4 pt-6">
    <PatentFilter lang={lang} active={view} counts={counts} />
  </div>

  <Section>
    {groups.length === 0 && <EmptyState lang={lang} />}
    <div class="flex flex-col gap-2">
      {
        groups.map((group) => (
          <YearGroup year={group.year}>
            <ul class="divide-y divide-line">
              {group.items.map((p) => {
                const title = localizedText(p, "title", lang);
                // Notion 선택지 값 그대로 라벨링. 모르는 값이면 원문을 표시한다.
                const countryLabel = optionLabel("patentCountry", p.country, lang);
                return (
                  title && (
                    <li class="py-3">
                      <div class="flex flex-wrap items-baseline gap-2">
                        {countryLabel && (
                          <span
                            class="shrink-0 rounded border border-line px-1.5 py-0.5 text-xs font-semibold text-ink-muted"
                            aria-label={`${t("patent.countryLabel")}: ${countryLabel}`}
                          >
                            {countryLabel}
                          </span>
                        )}
                        <span class="font-medium text-ink">{title}</span>
                      </div>
                      <p class="mt-0.5 text-sm text-ink-muted">
                        {p.number} · {t("patent.inventorsLabel")}: {p.inventors}
                      </p>
                    </li>
                  )
                );
              })}
            </ul>
          </YearGroup>
        ))
      }
    </div>
  </Section>
</BaseLayout>
