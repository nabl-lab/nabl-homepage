---
// 연구실 소개 (/[lang]/about).
import BaseLayout from "../../layouts/base-layout.astro";
import PageHeader from "../../components/page-header.astro";
import Section from "../../components/section.astro";
import {
  members,
  localizedText,
  paragraphs,
  siteContent,
  PI_POSITION,
} from "../../lib/content";
import { localePaths, useTranslations, withLocale, type Locale } from "../../i18n/utils";
import { collectionLabel } from "../../config/collections";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// 소개·비전은 Notion 「페이지 문구」에서 온다 (예전 src/data/about.json).
// 소개는 여러 문단이고, 비면 영역 자체를 렌더하지 않는다 (빌드 경고가 남는다).
const introParagraphs = paragraphs(siteContent, "about.intro", lang);
const missionParagraphs = paragraphs(siteContent, "about.mission", lang);
const pi = members.find((m) => m.position === PI_POSITION);
const piName = pi ? localizedText(pi, "name", lang) : null;
---

<BaseLayout
  lang={lang}
  title={t("about.title")}
  description={introParagraphs[0] ?? undefined}
>
  <PageHeader title={t("about.title")} lede={t("about.lede")} />

  <Section>
    {
      introParagraphs.length > 0 && (
        <div class="flex max-w-3xl flex-col gap-4">
          {introParagraphs.map((text) => (
            <p class="text-lg leading-relaxed text-ink">{text}</p>
          ))}
        </div>
      )
    }
    {
      piName && (
        <p class="mt-6 text-sm text-ink-muted">
          {t("about.piLabel")}:
          <span class="font-medium text-ink"> {piName}</span>
        </p>
      )
    }
    <p class="mt-1 text-sm text-ink-muted">{t("site.affiliation")}</p>
  </Section>

  {
    missionParagraphs.length > 0 && (
      <Section title={t("about.missionTitle")} muted>
        <div class="flex max-w-3xl flex-col gap-4">
          {missionParagraphs.map((text) => (
            <p class="text-lg leading-relaxed text-ink">{text}</p>
          ))}
        </div>
      </Section>
    )
  }

  <Section>
    <div class="flex flex-wrap gap-6 text-sm font-medium">
      <a href={withLocale(lang, "/research")} class="text-brand hover:underline">
        {t("nav.research")} →
      </a>
      <a href={withLocale(lang, "/members")} class="text-brand hover:underline">
        {collectionLabel("members", lang)} →
      </a>
    </div>
  </Section>
</BaseLayout>
