---
// 연구실 소개 (/[lang]/about).
import BaseLayout from "../../layouts/base-layout.astro";
import PageHeader from "../../components/page-header.astro";
import Section from "../../components/section.astro";
import { about, members, localizedText } from "../../lib/content";
import { localePaths, useTranslations, withLocale, type Locale } from "../../i18n/utils";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const intro = localizedText(about, "intro", lang);
const mission = localizedText(about, "mission", lang);
const pi = members.find((m) => m.position === "Principal Investigator");
const piName = pi ? localizedText(pi, "name", lang) : null;
---

<BaseLayout lang={lang} title={t("about.title")} description={intro ?? undefined}>
  <PageHeader title={t("about.title")} lede={t("about.lede")} />

  <Section>
    {intro && <p class="max-w-3xl text-lg leading-relaxed text-ink">{intro}</p>}
    {
      piName && (
        <p class="mt-6 text-sm text-ink-muted">
          {t("position.pi")}:
          <span class="font-medium text-ink"> {piName}</span>
        </p>
      )
    }
    <p class="mt-1 text-sm text-ink-muted">{t("site.affiliation")}</p>
  </Section>

  {
    mission && (
      <Section title={t("about.missionTitle")} muted>
        <p class="max-w-3xl text-lg leading-relaxed text-ink">{mission}</p>
      </Section>
    )
  }

  <Section>
    <div class="flex flex-wrap gap-6 text-sm font-medium">
      <a href={withLocale(lang, "/research")} class="text-brand hover:underline">
        {t("nav.research")} →
      </a>
      <a href={withLocale(lang, "/members")} class="text-brand hover:underline">
        {t("nav.members")} →
      </a>
    </div>
  </Section>
</BaseLayout>
