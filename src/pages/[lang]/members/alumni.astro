---
// 졸업생 (/[lang]/members/alumni).
//
// /members 아래의 Alumni 섹션과 **같은 파생 데이터·같은 컴포넌트**를 쓴다.
// 예전에는 alumni.json 더미를 학위 과정별로 묶어 보여줬지만, 이제 졸업생은
// 구성원 DB 의 `구성원 상태`(졸업 / 퇴직·퇴실)에서 나온다 (lib/members.ts).
// 두 화면이 어긋나지 않게 하려고 이 페이지도 같은 소스를 읽는다.
//
// 헤더 메뉴에 이 경로가 등록돼 있어 라우트는 유지한다 (nav.ts).
import BaseLayout from "../../../layouts/base-layout.astro";
import PageHeader from "../../../components/page-header.astro";
import Section from "../../../components/section.astro";
import AlumniList from "../../../components/alumni-list.astro";
import EmptyState from "../../../components/empty-state.astro";
import { alumni } from "../../../lib/content";
import {
  localePaths,
  useTranslations,
  withLocale,
  type Locale,
} from "../../../i18n/utils";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("alumni.title")} description={t("alumni.lede")}>
  <PageHeader title={t("alumni.title")} lede={t("alumni.lede")} />

  <Section>
    {alumni.length === 0 && <EmptyState lang={lang} />}
    {alumni.length > 0 && <AlumniList groups={alumni} lang={lang} />}
  </Section>

  <Section muted>
    <a
      href={withLocale(lang, "/members")}
      class="text-sm font-medium text-brand hover:underline"
    >
      {t("alumni.backToMembers")}
    </a>
  </Section>
</BaseLayout>
