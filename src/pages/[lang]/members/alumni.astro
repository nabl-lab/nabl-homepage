---
// 졸업생 (/[lang]/members/alumni). Current Members 와 같은 "학위 과정별 섹션" 구조.
// 그룹 안 정렬: 졸업연도 내림차순 → 같은 해면 이름순.
import BaseLayout from "../../../layouts/base-layout.astro";
import PageHeader from "../../../components/page-header.astro";
import Section from "../../../components/section.astro";
import PersonPhoto from "../../../components/person-photo.astro";
import { alumni, groupByPosition, localizedText } from "../../../lib/content";
import {
  localePaths,
  useTranslations,
  withLocale,
  POSITION_LABEL_KEY,
  type Locale,
  type UiKey,
} from "../../../i18n/utils";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const sorted = [...alumni].sort(
  (a, b) =>
    b.graduatedYear - a.graduatedYear ||
    (localizedText(a, "name", lang) ?? "").localeCompare(
      localizedText(b, "name", lang) ?? "",
      lang,
    ),
);
const groups = groupByPosition(sorted);

// 직책 표기: 매핑에 있으면 번역, 없으면 원문 그대로 (PI·연구교수가 데이터에 있어도 표시됨).
const positionLabel = (position: string): string => {
  const key = POSITION_LABEL_KEY[position] as UiKey | undefined;
  return key ? t(key) : position;
};
---

<BaseLayout
  lang={lang}
  title={t("alumni.title")}
  description={t("alumni.lede")}
>
  <PageHeader title={t("alumni.title")} lede={t("alumni.lede")} />

  <div class="mx-auto max-w-6xl px-4 pt-6">
    <a
      href={withLocale(lang, "/members")}
      class="text-sm font-medium text-brand hover:underline"
    >
      {t("alumni.backToMembers")}
    </a>
  </div>

  {
    groups.map((g) => (
      <Section title={positionLabel(g.position)}>
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((a) => {
            const name = localizedText(a, "name", lang) ?? a.id;
            const thesis = localizedText(a, "thesis_title", lang);
            return (
              <li class="flex flex-col rounded-lg border border-line bg-surface p-5">
                <PersonPhoto name={name} lang={lang} />
                <p class="mt-3 font-semibold text-ink">{name}</p>
                <p class="mt-0.5 text-sm text-ink-muted">{a.graduatedYear}</p>
                {thesis && (
                  <p class="mt-2 text-sm leading-relaxed text-ink">{thesis}</p>
                )}
                {/*
                  졸업 후 소속(afterAffiliation / afterAffiliation_ko)은 데이터에
                  남아 있으나 지금은 화면에 표시하지 않는다. 다시 넣으려면 아래 해제:
                  {localizedText(a, "afterAffiliation", lang) && (
                    <p class="mt-2 text-sm text-ink-muted">
                      {t("alumni.afterLabel")}:{" "}
                      {localizedText(a, "afterAffiliation", lang)}
                    </p>
                  )}
                */}
              </li>
            );
          })}
        </ul>
      </Section>
    ))
  }
</BaseLayout>
