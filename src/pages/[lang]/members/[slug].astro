---
// 구성원 상세 (/[lang]/members/<slug>).
//
// 신원 → 연구 관심사 → 연구 분야 → 학위 이력 순서. 비어 있는 블록은 통째로 숨긴다.
// 앞 세 블록은 PI 페이지와 **같은 컴포넌트**를 쓴다 (components/person/).
// 학력·경력·대외활동은 piProfile DB 가 교수님 것뿐이라 여기엔 없다.
import BaseLayout from "../../../layouts/base-layout.astro";
import PageHeader from "../../../components/page-header.astro";
import SectionBlock from "../../../components/person/section-block.astro";
import Identity from "../../../components/person/identity.astro";
import ResearchInterests from "../../../components/person/research-interests.astro";
import ResearchAreas from "../../../components/person/research-areas.astro";
import { currentMemberList, localizedText, type Member } from "../../../lib/content";
import { withUniqueSlug } from "../../../lib/notion/validate";
import { collectionLabel } from "../../../config/collections";
import {
  LOCALES,
  useTranslations,
  withLocale,
  optionLabel,
  type Locale,
} from "../../../i18n/utils";

export function getStaticPaths() {
  // 졸업생은 사진·연구 소개가 없어 상세 페이지를 만들지 않는다 (목록에만 나온다).
  // Slug 가 비거나 겹친 사람도 제외된다 — 빈 Slug 는 경로가 접혀 목록과 충돌한다.
  const detailable = withUniqueSlug(currentMemberList);
  return LOCALES.flatMap((lang) =>
    detailable.map((m) => ({
      params: { lang, slug: m.slug },
      props: { member: m },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { member } = Astro.props as { member: Member };
const t = useTranslations(lang);

const name = localizedText(member, "name", lang) ?? member.name_ko;
const topic = localizedText(member, "researchTopic", lang);
const description = localizedText(member, "researchDescription", lang);

// <meta description>: 설명 → 주제 → 사이트 기본 설명 순으로 고른다.
const metaDescription = description ?? topic ?? undefined;
---

<BaseLayout lang={lang} title={name} description={metaDescription}>
  <PageHeader
    title={name}
    lede={optionLabel("memberPosition", member.position, lang)}
  />

  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 pb-16">
    <Identity member={member} lang={lang} />

    {
      (topic || description) && (
        <SectionBlock title={t("pi.researchInterests")}>
          <ResearchInterests member={member} lang={lang} />
        </SectionBlock>
      )
    }

    {
      member.researchAreas.length > 0 && (
        <SectionBlock title={collectionLabel("research", lang)}>
          <ResearchAreas areas={member.researchAreas} lang={lang} />
        </SectionBlock>
      )
    }

    {
      member.degreeHistory.length > 0 && (
        <SectionBlock title={t("member.degreeLabel")}>
          <ul class="flex flex-col gap-1 text-sm leading-relaxed text-ink-muted">
            {member.degreeHistory.map((line) => (
              <li>{line}</li>
            ))}
          </ul>
        </SectionBlock>
      )
    }

    <div class="border-t border-line pt-8">
      <a
        href={withLocale(lang, "/members")}
        class="text-sm font-medium text-brand hover:underline"
      >
        ← {t("members.currentTitle")}
      </a>
    </div>
  </div>
</BaseLayout>
