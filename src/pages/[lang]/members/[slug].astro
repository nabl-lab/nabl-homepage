---
// 구성원 상세 (/[lang]/members/[slug]).
// Slug 가 있는 구성원만 생성된다. Slug 가 비면 목록에만 나오고 이 페이지는 만들어지지 않는다.
import BaseLayout from "../../../layouts/base-layout.astro";
import PageHeader from "../../../components/page-header.astro";
import Section from "../../../components/section.astro";
import PersonPhoto from "../../../components/person-photo.astro";
import { members, localizedText, type Member } from "../../../lib/content";
import { withUniqueSlug } from "../../../lib/notion/validate";
import {
  LOCALES,
  useTranslations,
  withLocale,
  optionLabel,
  type Locale,
} from "../../../i18n/utils";

export function getStaticPaths() {
  const detailable = withUniqueSlug(members);
  return LOCALES.flatMap((lang) =>
    detailable.map((m) => ({
      params: { lang, slug: m.slug },
      props: { member: m },
    })),
  );
}

const lang = Astro.params.lang as Locale;
const { member } = Astro.props as { member: Member };
const t = useTranslations(lang);

const name = localizedText(member, "name", lang) ?? member.name_ko;
const topic = localizedText(member, "researchTopic", lang);
// 연구 설명은 상세 페이지에서 잘라내지 않고 전체를 보여 준다.
const description = localizedText(member, "researchDescription", lang);

// <meta description>: 한국어 페이지에서만 연구 설명을 우선 쓴다.
// 연구 설명에는 Notion 영문 칸이 없어 /en 에서도 한국어 원문이 폴백으로 오는데,
// 영문 페이지의 메타 설명까지 한국어로 채우면 검색 결과·공유 미리보기가 어색해진다.
// 영문 표시 방식이 정해지면 이 분기를 지운다 (CLAUDE.md 14번).
const metaDescription = (lang === "ko" ? description : null) ?? topic ?? undefined;

// 연구 분야 — 이름은 항상, 링크는 공개된 행에만.
// (상세 라우트 /[lang]/research/[slug] 는 아직 없다. 전 행이 미공개라 지금은 링크가
//  하나도 생기지 않는다. Research 행을 공개하기 전에 그 라우트를 먼저 만들어야 한다.)
const researchAreas = member.researchAreas
  .map((a) => ({
    label: localizedText(a, "title", lang),
    href: a.publish && a.slug ? withLocale(lang, `/research/${a.slug}`) : null,
  }))
  .filter((a) => a.label);
const positionLabel = optionLabel("memberPosition", member.position, lang);
---

<BaseLayout
  lang={lang}
  title={name}
  description={metaDescription}
>
  <PageHeader title={name} lede={positionLabel} />

  <Section>
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start">
      <div class="w-full max-w-48 shrink-0">
        <PersonPhoto name={name} photo={member.photo} lang={lang} />
      </div>

      <dl class="flex flex-1 flex-col gap-3 text-sm">
        {
          /*
            연구 분야 — Notion 관계에서 온다. 분야 행이 아직 공개(Publish)되지 않았어도
            **이름은 보여 준다** (공개 전에 이 영역이 비어 보이지 않게). 상세 링크는
            공개되고 Slug 가 있는 행에만 건다.
            0개면 블록 자체를 렌더하지 않는다 (빈 줄이 남지 않게).
          */
          researchAreas.length > 0 && (
            <div>
              <dt class="font-semibold text-ink">{t("member.areasLabel")}</dt>
              <dd class="mt-1 flex flex-wrap gap-1.5">
                {researchAreas.map((a) =>
                  a.href ? (
                    <a
                      href={a.href}
                      class="rounded-full border border-line px-2.5 py-0.5 text-xs text-brand hover:bg-brand-tint"
                    >
                      {a.label}
                    </a>
                  ) : (
                    <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-ink-muted">
                      {a.label}
                    </span>
                  ),
                )}
              </dd>
            </div>
          )
        }
        {
          /*
            연구 주제와 연구 설명은 같은 <dt> 아래 묶는다 (설명이 주제를 풀어 쓴 글이라
            별도 항목으로 세우면 위계가 흐려진다. <dl> 은 dt 하나에 dd 여러 개가 유효하다).
            둘 중 하나만 있어도 블록이 나오고, 둘 다 비면 블록 자체를 렌더하지 않는다.
          */
          (topic || description) && (
            <div>
              <dt class="font-semibold text-ink">{t("member.topicLabel")}</dt>
              {topic && (
                <dd class="mt-0.5 leading-relaxed text-ink-muted">{topic}</dd>
              )}
              {description && (
                <dd class="mt-1 text-sm leading-relaxed text-ink-subtle">
                  {description}
                </dd>
              )}
            </div>
          )
        }
        {
          member.email && (
            <div>
              <dt class="font-semibold text-ink">{t("common.email")}</dt>
              <dd class="mt-0.5">
                <a
                  href={`mailto:${member.email}`}
                  class="text-brand hover:underline"
                >
                  {member.email}
                </a>
              </dd>
            </div>
          )
        }
        {
          member.joinedDate && (
            <div>
              <dt class="font-semibold text-ink">{t("member.joinedLabel")}</dt>
              <dd class="mt-0.5 text-ink-muted">{member.joinedDate}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <p class="mt-10 border-t border-line pt-6">
      <a
        href={withLocale(lang, "/members")}
        class="text-sm font-medium text-brand hover:underline"
      >
        ← {t("members.currentTitle")}
      </a>
    </p>
  </Section>
</BaseLayout>
