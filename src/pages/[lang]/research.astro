---
// 연구 (/[lang]/research). Scope / Themes / Projects 세 섹션. 헤더 하위 메뉴가 앵커로 연결된다.
import BaseLayout from "../../layouts/base-layout.astro";
import PageHeader from "../../components/page-header.astro";
import Section from "../../components/section.astro";
import EmptyState from "../../components/empty-state.astro";
import PublicationItem from "../../components/publication-item.astro";
import {
  researchAreas,
  researchProjects,
  publications,
  localizedText,
} from "../../lib/content";
import { hasDetailPage, scopeAreas, themeAreas } from "../../lib/research";
import {
  localePaths,
  useTranslations,
  withLocale,
  type Locale,
} from "../../i18n/utils";
import { collectionLabel } from "../../config/collections";
import {
  formatPeriod,
  isOngoing,
  seoulBuildDate,
  sortProjects,
} from "../../lib/projects";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// Notion Research DB 한 곳에 Scope(연구 범위)와 Theme(세부 주제)이 같이 들어 있다.
// 쓰는 방식이 달라 lib/research.ts 가 가른다 — Scope 는 상단 소개 문구,
// Theme 는 카드 목록. 둘 다 Order 오름차순이고, 한쪽이 0건이어도 레이아웃이 안 깨진다.
const scopeItems = scopeAreas(researchAreas)
  .map((s) => ({ id: s.id, body: localizedText(s, "summary", lang) }))
  .filter((s) => s.body);

// 카드에는 미공개 분야도 이름을 보여 주고, 상세 링크는 공개된 행에만 건다
// (공개 전에도 목록이 비어 보이지 않게).
const areas = themeAreas(researchAreas)
  .map((a) => ({
    id: a.id,
    code: a.code,
    title: localizedText(a, "title", lang),
    summary: localizedText(a, "summary", lang),
    keywords: a.keywords,
    href: hasDetailPage(a) ? withLocale(lang, `/research/${a.slug}`) : null,
  }))
  .filter((a) => a.title);

const scope = scopeItems[0]?.body ?? null; // meta description 용

// 연구 분야와 논문의 관계를 화면에서 잇는다 — 최근 5건만 보여주고 전체는 링크로.
// year 는 null 일 수 있으므로("연도 미상") 0 으로 보아 맨 뒤로 보낸다.
const recentPublications = [...publications]
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0))
  .slice(0, 5);

// 연구 과제 — 진행 중이 위, 그다음 시작일 내림차순 (규칙은 lib/projects.ts).
// 진행 중 판정은 "마지막 빌드 시점" 기준이다. 과제가 끝나면 Notion 을 고치고
// 재배포해야 목록이 따라온다 (README 에도 적어 두었다).
const buildDate = seoulBuildDate();
const projectRows = sortProjects(researchProjects, buildDate, lang)
  .map((p) => ({
    id: p.id,
    title: localizedText(p, "title", lang),
    // localizedText 가 양방향 폴백을 해 준다 — 영문 기관명이 비면 국문이 나온다.
    funder: localizedText(p, "funder", lang),
    description: localizedText(p, "description", lang),
    ongoing: isOngoing(p, buildDate),
    period: formatPeriod(
      p.startDate,
      p.endDate,
      isOngoing(p, buildDate),
      t("research.projectPresent"),
    ),
  }))
  .filter((p) => p.title);
---

<BaseLayout lang={lang} title={t("nav.research")} description={scope ?? undefined}>
  <PageHeader title={t("nav.research")} lede={t("research.lede")} />

  <Section id="scope" title={t("nav.research.scope")}>
    {scopeItems.length === 0 && <EmptyState lang={lang} />}
    <div class="flex max-w-3xl flex-col gap-4">
      {
        scopeItems.map((s) => (
          <p class="text-lg leading-relaxed text-ink">{s.body}</p>
        ))
      }
    </div>
  </Section>

  <Section id="themes" title={collectionLabel("research", lang)} muted>
    {areas.length === 0 && <EmptyState lang={lang} />}
    <div class="grid gap-6 sm:grid-cols-2">
      {
        areas.map((a) => (
          <article class="flex flex-col rounded-lg border border-line bg-surface p-5">
            <h3 class="flex items-baseline gap-2 text-base font-semibold text-ink">
              {a.code && (
                <span class="shrink-0 rounded border border-line px-1.5 py-0.5 text-xs font-semibold text-ink-muted">
                  {a.code}
                </span>
              )}
              {a.href ? (
                <a href={a.href} class="text-brand hover:underline">
                  {a.title}
                </a>
              ) : (
                a.title
              )}
            </h3>
            {a.summary && (
              <p class="mt-2 text-sm leading-relaxed text-ink">{a.summary}</p>
            )}
            {a.keywords.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-1.5">
                {a.keywords.map((k) => (
                  <li class="rounded-full bg-surface-muted px-2 py-0.5 text-xs text-ink-muted">
                    {k}
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="projects" title={collectionLabel("projects", lang)}>
    {projectRows.length === 0 && <EmptyState lang={lang} />}
    <ul
      class:list={[
        "flex flex-col divide-y divide-line",
        projectRows.length > 0 && "border-y border-line",
      ]}
    >
      {
        projectRows.map((p) => (
          <li class="py-4">
            <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
              {p.ongoing && (
                <span class="shrink-0 rounded-full bg-brand-tint px-2 py-0.5 text-xs font-semibold text-brand">
                  {t("research.projectsOngoing")}
                </span>
              )}
              <span class="font-medium text-ink">{p.title}</span>
            </div>
            {/* 기관·기간은 둘 다 없을 수 있다. 빈 줄이 남지 않게 한쪽이라도 있을 때만 그린다. */}
            {(p.funder || p.period) && (
              <p class="mt-1 text-sm text-ink-muted">
                {[
                  p.funder && `${t("research.projectFunder")}: ${p.funder}`,
                  p.period,
                ]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
            )}
            {p.description && (
              <p class="mt-1 max-w-prose text-sm leading-relaxed text-ink-subtle">
                {p.description}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </Section>

  {
    recentPublications.length > 0 && (
      <Section id="publications" title={collectionLabel("publications", lang)} muted>
        <a
          slot="cta"
          href={withLocale(lang, "/research/publications")}
          aria-label={`${t("common.viewAll")} — ${collectionLabel("publications", lang)}`}
          class="shrink-0 text-sm font-medium text-brand hover:underline"
        >
          {t("common.viewAll")} →
        </a>
        <div class="divide-y divide-line border-y border-line">
          {recentPublications.map((p) => (
            <PublicationItem publication={p} lang={lang} />
          ))}
        </div>
      </Section>
    )
  }
</BaseLayout>
