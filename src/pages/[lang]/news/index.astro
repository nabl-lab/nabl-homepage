---
// 소식 목록 (/[lang]/news). 최신순, 제목이 양쪽 언어 모두 비면 건너뛴다.
// 카드: 커버 이미지(있을 때만) · 날짜 + 분류 배지 · 제목 · 요약(2줄 말줄임).
// 요약·분류·커버는 비어 있으면 그 자리를 아예 만들지 않는다.
import BaseLayout from "../../../layouts/base-layout.astro";
import PageHeader from "../../../components/page-header.astro";
import Section from "../../../components/section.astro";
import EmptyState from "../../../components/empty-state.astro";
import { news, byDateDesc, localizedText } from "../../../lib/content";
import {
  localePaths,
  useTranslations,
  withLocale,
  optionLabel,
  type Locale,
} from "../../../i18n/utils";
import { collectionLabel } from "../../../config/collections";

export const getStaticPaths = localePaths;

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const items = byDateDesc(news)
  .map((n) => ({
    slug: n.slug,
    date: n.date,
    title: localizedText(n, "title", lang),
    summary: localizedText(n, "summary", lang),
    category: optionLabel("newsCategory", n.category, lang),
    cover: n.cover,
  }))
  .filter((n) => n.title);

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString(lang === "ko" ? "ko-KR" : "en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<BaseLayout lang={lang} title={collectionLabel("news", lang)} description={t("news.lede")}>
  <PageHeader title={collectionLabel("news", lang)} lede={t("news.lede")} />

  <Section>
    {items.length === 0 && <EmptyState lang={lang} />}
    <ul
      class:list={[
        "divide-y divide-line",
        items.length > 0 && "border-y border-line",
      ]}
    >
      {
        items.map((n) => (
          <li>
            <a href={withLocale(lang, `/news/${n.slug}`)} class="group flex gap-4 py-4">
              {n.cover && (
                /* 제목이 바로 옆에 있으므로 장식 이미지로 둔다 (alt 비움) */
                <img
                  src={n.cover}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-24 shrink-0 rounded object-cover sm:h-20 sm:w-28"
                />
              )}
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <time datetime={n.date} class="text-sm text-ink-muted">
                    {fmtDate(n.date)}
                  </time>
                  {n.category && (
                    <span class="rounded-full bg-brand-tint px-2 py-0.5 text-xs font-semibold text-brand">
                      {n.category}
                    </span>
                  )}
                </div>
                <span class="mt-1 block font-medium text-ink underline-offset-2 group-hover:text-brand group-hover:underline">
                  {n.title}
                </span>
                {n.summary && (
                  <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-ink-muted">
                    {n.summary}
                  </p>
                )}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>
