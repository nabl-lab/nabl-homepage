---
// 루트(/) 접속을 기본 언어 홈(/en/)으로 즉시 보낸다.
// 정적 호스팅 어디서나 동작하도록 meta refresh + 스크립트 + 링크를 함께 둔다.
const target = "/en/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <title>Redirecting to {target}</title>
    <script is:inline>
      window.location.replace("/en/");
    </script>
  </head>
  <body>
    <a href={target}>Continue to the NABL homepage</a>
  </body>
</html>
