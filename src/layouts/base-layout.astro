---
// 모든 페이지가 공유하는 레이아웃. <head> 메타데이터, 전역 스타일, 헤더/푸터를 한곳에서 관리.
import "../styles/global.css";
import SiteHeader from "../components/site-header.astro";
import SiteFooter from "../components/site-footer.astro";
import {
  useTranslations,
  switchLocalePath,
  LOCALES,
  type Locale,
} from "../i18n/utils";
import { SITE, OG_LOCALE } from "../config/site";

interface Props {
  /** 현재 페이지 언어 (URL 의 [lang] 세그먼트) */
  lang: Locale;
  /** 페이지 고유 제목. 비우면 사이트 정식 명칭이 <title> 에 들어간다. */
  title: string;
  /** meta description. 안 주면 사이트 기본 설명(site.description) 사용 */
  description?: string;
  /** OG 이미지 경로 오버라이드 (기본: SITE.ogImage) */
  image?: string;
}

const { lang, title, description, image } = Astro.props;
const t = useTranslations(lang);

const fullTitle = title ? `${title} · ${t("site.shortName")}` : t("site.name");
const metaDescription = description ?? t("site.description");
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const altLocales = LOCALES.filter((l) => l !== lang);
const altUrl = (l: Locale) => new URL(switchLocalePath(path, l), SITE.url).href;
const ogImageSrc = image ?? SITE.ogImage;
const ogImage = ogImageSrc ? new URL(ogImageSrc, SITE.url).href : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* 언어 대체 (hreflang) */}
    <link rel="alternate" hreflang={lang} href={canonical} />
    {
      altLocales.map((l) => (
        <link rel="alternate" hreflang={l} href={altUrl(l)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={altUrl("en")} />

    {/* Open Graph — 카톡·슬랙·페이스북 공유 미리보기 */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("site.name")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {
      altLocales.map((l) => (
        <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
      ))
    }
    {ogImage && <meta property="og:image" content={ogImage} />}

    {/* Twitter Card — 슬랙도 이 태그를 참고 */}
    <meta
      name="twitter:card"
      content={ogImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
  </head>
  <body class="flex min-h-screen flex-col bg-surface text-ink">
    <a
      href="#main"
      class="sr-only rounded bg-brand px-4 py-2 text-brand-contrast focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
    >
      {t("a11y.skipToContent")}
    </a>
    <SiteHeader lang={lang} />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
